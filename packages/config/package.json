{
  "name": "@sunnie/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Oxlint, Oxfmt, and TypeScript settings.",
  "files": [
    "dist",
    "tsconfig"
  ],
  "type": "module",
  "exports": {
    "./oxlint": "./dist/oxlint/base.mjs",
    "./oxlint/next": "./dist/oxlint/next.mjs",
    "./oxfmt": "./dist/oxfmt.mjs",
    "./tsconfig/*": "./tsconfig/*",
    "./oxlint/react": "./dist/oxlint/react.mjs"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
