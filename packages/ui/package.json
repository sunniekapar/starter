{
  "name": "@sunnie/ui",
  "version": "0.2.6",
  "private": true,
  "description": "Shared React components, hooks, utilities, and Tailwind CSS styles.",
  "files": [
    "dist",
    "styles.css",
    "typeset.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./src/lib/utils.ts",
      "import": "./dist/lib/utils.js"
    },
    "./styles.css": "./styles.css",
    "./*": {
      "types": "./src/components/ui/*.tsx",
      "import": "./dist/components/ui/*.js"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "import": "./dist/hooks/*.js"
    },
    "./components/*": {
      "types": "./src/components/ui/*.tsx",
      "import": "./dist/components/ui/*.js"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./dist/lib/*.js"
    },
    "./typeset.css": "./typeset.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./utils": {
        "types": "./dist/lib/utils.d.ts",
        "import": "./dist/lib/utils.js"
      },
      "./styles.css": "./styles.css",
      "./*": {
        "types": "./dist/components/ui/*.d.ts",
        "import": "./dist/components/ui/*.js"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "import": "./dist/hooks/*.js"
      },
      "./components/*": {
        "types": "./dist/components/ui/*.d.ts",
        "import": "./dist/components/ui/*.js"
      },
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "import": "./dist/lib/*.js"
      },
      "./typeset.css": "./typeset.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm --filter @sunnie/config build && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "catalog:",
    "react-resizable-panels": "^4.12.4",
    "recharts": "catalog:",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sunnie/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
