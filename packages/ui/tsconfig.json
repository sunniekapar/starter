{
  "extends": "@sunnie/config/tsconfig/node.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "oxlint.config.ts"],
  "exclude": ["node_modules", "dist"]
}
