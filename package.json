{
  "name": "@sunnie/starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @sunnie/ui --filter @sunnie/docs dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' -r build",
    "build:ui": "pnpm --filter @sunnie/ui... build",
    "build:config": "pnpm --filter @sunnie/config build",
    "build:docs": "pnpm --filter @sunnie/docs... build",
    "start": "pnpm --filter @sunnie/docs start",
    "lint": "pnpm build:config && pnpm -r lint && oxlint --deny-warnings ./*.config.ts",
    "lint:fix": "pnpm build:config && pnpm -r lint:fix && oxlint --fix ./*.config.ts",
    "fmt": "pnpm build:config && oxfmt",
    "fmt:check": "pnpm build:config && oxfmt --check",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "pack:ui": "pnpm --filter @sunnie/ui pack --pack-destination artifacts",
    "pack:config": "pnpm --filter @sunnie/config pack --pack-destination artifacts",
    "release": "bash scripts/release.sh",
    "docs:generate": "pnpm --filter @sunnie/docs docs:generate"
  },
  "devDependencies": {
    "@sunnie/config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0"
}
