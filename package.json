{
  "name": "@sunnie/ui",
  "version": "0.2.00",
  "private": true,
  "description": "Shared UI components with a Next.js preview app.",
  "files": [
    "dist",
    "styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./styles.css": "./styles.css",
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    }
  },
  "scripts": {
    "dev": "pnpm docs:generate && portless run next dev",
    "build": "pnpm docs:generate && pnpm build:ui && next build",
    "build:ui": "tsc -p tsconfig.build.json",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm docs:generate && next typegen && tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "prepack": "pnpm build:ui",
    "release": "bash scripts/release.sh",
    "docs:generate": "node scripts/generate-docs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sunnie/config": "file:../config",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "portless": "^0.15.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0"
}
